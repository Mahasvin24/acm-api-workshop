{
  "info": {
    "name": "ACM at UCSB \u00b7 API Social registry",
    "description": "Read the directory and register your API. Set the host URL and your Wi-Fi IP in collection variables.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "registry_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "student_ip",
      "value": "192.168.1.42",
      "type": "string"
    },
    {
      "key": "student_port",
      "value": "8000",
      "type": "string"
    },
    {
      "key": "api_name",
      "value": "Restaurant Notes",
      "type": "string"
    },
    {
      "key": "creator",
      "value": "Your name",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Read the directory",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{registry_url}}/api/apis",
        "description": ""
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Directory loaded\", () => pm.response.to.have.status(200));"
            ]
          }
        }
      ]
    },
    {
      "name": "Register your API",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{registry_url}}/api/apis",
        "description": "Set collection variables, then send your registration.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"{{api_name}}\",\n  \"creator\": \"{{creator}}\",\n  \"description\": \"Restaurants and what we think of them.\",\n  \"ip\": \"{{student_ip}}\",\n  \"port\": {{student_port}}\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Registered\", () => pm.response.to.have.status(201));"
            ]
          }
        }
      ]
    }
  ]
}
